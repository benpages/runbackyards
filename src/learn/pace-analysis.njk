	var SCALE_MIN = 40, SCALE_RANGE = 20; // 40:00 to 60:00 minute scale
	var raceCache = {};
	var activeChart = null;
	var loadToken = 0;

	function parseMin(str) {
		if (!str) return null;
		var p = str.split(":").map(Number);
		return p[0] + p[1] / 60;
	}

	function fmtMin(m) {
		var mins = Math.floor(m);
		var secs = Math.round((m - mins) * 60);
		return mins + ":" + (secs < 10 ? "0" : "") + secs;
	}

	function toBarPct(m) {
		return Math.max(0, Math.min(100, (m - SCALE_MIN) / SCALE_RANGE * 100));
	}

	function renderBar(q1m, q3m, medm) {
		var medPct = toBarPct(medm).toFixed(1);
		var fill = "";
		if (q1m != null && q3m != null) {
			var lp = toBarPct(q1m).toFixed(1);
			var wp = (toBarPct(q3m) - toBarPct(q1m)).toFixed(1);
			fill = '<div class="pa-pace-fill" style="left:' + lp + '%;width:' + wp + '%"></div>';
		}
		var q1Label = q1m != null ? fmtMin(q1m) : "";
		var q3Label = q3m != null ? fmtMin(q3m) : "";
		return '<div class="pa-pace-wrap"><div class="pa-pace-track">' + fill +
			'<div class="pa-pace-median" style="left:' + medPct + '%"></div></div>' +
			'<div class="pa-pace-labels"><span>' + q1Label + '</span>' +
			'<span class="pa-pace-labels-mid">med ' + fmtMin(medm) + '</span>' +
			'<span>' + q3Label + '</span></div></div>';
	}

	function computeStats(laps) {
		var valid = laps.filter(function (v) { return v != null; });
		if (valid.length < 4) return null;
		var sorted = valid.slice().sort(function (a, b) { return a - b; });
		function pct(arr, p) {
			var i = p / 100 * (arr.length - 1);
			var lo = Math.floor(i), hi = Math.ceil(i);
			return arr[lo] + (arr[hi] - arr[lo]) * (i - lo);
		}
		var q1 = pct(sorted, 25), q3 = pct(sorted, 75), iqr = q3 - q1;
		var clean = sorted.filter(function (v) { return v >= q1 - 1.5 * iqr && v <= q3 + 1.5 * iqr; });
		var q1c = pct(clean, 25), q3c = pct(clean, 75), med = pct(clean, 50);
		return { q1: q1c, q3: q3c, median: med, cs: ((q3c - q1c) / med * 100).toFixed(1) };
	}

	function buildUrl(api) {
		var extra = api.extraParams || "";
		return "https://" + api.host + ".raceresult.com/" + api.eventId + "/" + api.page +
			"/list?key=" + api.apiKey + "&listname=" + encodeURIComponent(api.listname) +
			"&page=" + api.page + extra;
	}

	function toLapMin(t) {
		if (!t) return null;
		var p = t.split(":").map(Number);
		if (p.length === 3) return p[0] * 60 + p[1] + p[2] / 60;
		return p[0] + p[1] / 60;
	}

	async function fetchAthleteRows(api, storedName) {

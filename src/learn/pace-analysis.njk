			var resp = await fetch(buildUrl(api));
			if (!resp.ok) throw new Error("HTTP " + resp.status);
			var json = await resp.json();
			if (!json.data) throw new Error("no data");
			raceCache[key] = BackyardCharts.parseRaceresultData(json.data, api);
		}
		return raceCache[key].filter(function (r) { return r.athlete === storedName; });
	}


						title: { display: true, text: "Lap time (min)", color: "#999", font: { size: 10 } },
						ticks: { color: "#999", font: { size: 10 }, callback: function (v) { return v; } },
						grid: { color: "rgba(0,0,0,0.06)" }
					}
				}
			}
		});
	}

	/* ── Render grid ───────────────────────────────────────────────────────── */
	var gridEl = document.getElementById("paFighterGrid");
	var racesEl = document.getElementById("paFighterRaces");
	var panelEl = document.getElementById("paFighterPanel");

	ATHLETES.forEach(function (athlete) {
		var tile = document.createElement("div");
		tile.className = "pa-fighter-tile";
		tile.dataset.id = athlete.id;
		var sub = athlete.races.length === 1 ? "1 race" : athlete.races.length + " races";
		tile.innerHTML =
			'<div class="pa-fighter-avatar">' + athlete.initials + "</div>" +
			'<span class="pa-fighter-tile-name">' + athlete.name + "</span>" +
			'<span class="pa-fighter-tile-sub">' + sub + "</span>";
		tile.addEventListener("click", function () { selectAthlete(athlete.id); });
		gridEl.appendChild(tile);
	});

	var currentAthleteId = null;

	function selectAthlete(id) {
		if (currentAthleteId === id) return;
		currentAthleteId = id;
		gridEl.querySelectorAll(".pa-fighter-tile").forEach(function (t) {
			t.classList.toggle("selected", t.dataset.id === id);
		});
		var athlete = ATHLETES.find(function (a) { return a.id === id; });
		if (athlete.races.length > 1) {
			renderRacePills(athlete);
			racesEl.style.display = "flex";
		} else {
			racesEl.style.display = "none";
		}
		selectRace(id, 0);
	}

	function renderRacePills(athlete) {
		racesEl.innerHTML = "";
		athlete.races.forEach(function (race, idx) {
			var pill = document.createElement("button");
			pill.className = "pa-fighter-race-pill";
			pill.dataset.idx = idx;
			pill.textContent = race.label + " · " + race.loops + " laps";
			pill.addEventListener("click", function () { selectRace(athlete.id, idx); });
			racesEl.appendChild(pill);
		});
	}

	function syncPills(idx) {
		racesEl.querySelectorAll(".pa-fighter-race-pill").forEach(function (p) {
			p.classList.toggle("selected", parseInt(p.dataset.idx) === idx);
		});
	}

	async function selectRace(athleteId, raceIdx) {
		syncPills(raceIdx);
		var token = ++loadToken;
		var athlete = ATHLETES.find(function (a) { return a.id === athleteId; });
		var race = athlete.races[raceIdx];
		var st = race.stat;

		var q1m = parseMin(st.q1), q3m = parseMin(st.q3), medm = parseMin(st.median);
		var chips = [st.cs ? "CS " + st.cs + "%" : null, st.pace || null]
			.filter(Boolean).map(function (c) { return '<span class="pa-chip">' + c + "</span>"; }).join("");
		var liveHtml = race.api
			? '<div class="pa-fighter-chart-status" id="paChartStatus">Loading lap data…</div>' +
			  '<div class="pa-fighter-chart-wrap" id="paChartWrap" style="display:none"><canvas id="paChartCanvas"></canvas></div>'
			: "";

		panelEl.innerHTML =
			'<div class="pa-fighter-panel">' +
			'<p class="pa-fighter-panel-name">' + athlete.name + "</p>" +
			'<p class="pa-fighter-panel-meta">' + race.label + " · " + race.loops + " laps</p>" +
			'<div id="paBar">' + (medm != null ? renderBar(q1m, q3m, medm) : "") + "</div>" +
			(chips ? '<div class="pa-card-chips" style="margin-top:10px">' + chips + "</div>" : "") +
			liveHtml +
			"</div>";

		if (!race.api) return;

		try {
			var rows = await fetchAthleteRows(race.api, race.storedName);
			if (token !== loadToken) return; // stale — user moved on
			if (!rows.length) throw new Error("athlete not found");

			var maxLap = Math.max.apply(null, rows.map(function (r) {
				return parseInt(r.lap.replace(/\D/g, ""), 10);
			}));
			var lapMins = [];
			for (var i = 1; i <= maxLap; i++) {
				var row = rows.find(function (r) { return parseInt(r.lap.replace(/\D/g, ""), 10) === i; });
				lapMins.push(row ? toLapMin(row.finish_time) : null);
			}

			// If no pre-computed Q1/Q3, derive from live laps
			var q1Draw = q1m, q3Draw = q3m, medDraw = medm;
			if (q1m == null || q3m == null) {
				var live = computeStats(lapMins);
				if (live) {
					q1Draw = live.q1; q3Draw = live.q3; medDraw = live.median;
					var barEl = document.getElementById("paBar");
					if (barEl) barEl.innerHTML = renderBar(q1Draw, q3Draw, medDraw);
				}
			}

			var statusEl = document.getElementById("paChartStatus");
			var wrapEl = document.getElementById("paChartWrap");
			var canvasEl = document.getElementById("paChartCanvas");
			if (statusEl) statusEl.style.display = "none";
			if (wrapEl) wrapEl.style.display = "";
			renderChart(canvasEl, lapMins, medDraw != null ? medDraw : medm, race.api.startHour);

		} catch (err) {
			if (token !== loadToken) return;
			var statusEl2 = document.getElementById("paChartStatus");
			if (statusEl2) statusEl2.textContent = "Chart unavailable for this race.";
		}
	}

})();
</script>

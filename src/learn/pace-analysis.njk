			for (var i = 1; i <= maxLap + 1; i++) {
				var hour = (startHour + i - 1) % 24;
				var isNight = hour >= 21 || hour < 6;
				if (isNight && open === null) open = i - 1.5;
				if (!isNight && open !== null) {
					annotations["night" + i] = { type: "box", xMin: open, xMax: i - 1.5, yMin: 38, yMax: 65, backgroundColor: "rgba(20,30,90,0.07)", borderWidth: 0 };
					open = null;
				}
			}
			if (open !== null) {

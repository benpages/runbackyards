<form
			name="waitlist"
			method="POST"
			data-netlify="true"
			netlify-honeypot="bot-field"
			class="page-newsletter-form"
		>
  <input type="hidden" name="form-name" value="waitlist"/>
  <p style="display:none">
    <label>Skip this: <input name="bot-field"/></label>
  </p>
  <input
				type="email"
				name="email"
				placeholder="your@email.com"
				required
				autocomplete="email"
				class="page-newsletter-input"
			/>
  <button type="submit" class="page-newsletter-btn">Notify me</button>
</form>
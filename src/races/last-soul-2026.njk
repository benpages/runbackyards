</div>

<script>
(function () {
	const button = document.getElementById("standingsToggle");
	const body = document.getElementById("standingsBody");
	if (!button || !body) {
		return;
	}
	let expanded = false;
	const total = body
		.querySelectorAll("tr")
		.length;
	button.addEventListener("click", function () {
		expanded = !expanded;
		body
			.querySelectorAll("tr")
			.forEach(function (row, index) {
				row
					.classList
					.toggle("is-hidden", !expanded && index >= 20);
			});
		button.textContent = expanded
			? "Show top 20 only"
			: "Show all " + total + " runners";
	});
})();
</script>


<div class="standings-section">
	<div class="section-header">
		<div>
			<div class="section-title">Final Standings</div>
			<div class="section-desc">All {{ lastSoul2026.runners | length }} starters · loops, distance and time on course</div>
		</div>
	</div>
	<div class="standings-wrap">
		<table class="standings">
			<thead>
				<tr>
					<th>Pl.</th>
					<th>Runner</th>
					<th>Loops</th>
					<th>Distance</th>
					<th>Total time</th>
				</tr>
			</thead>
			<tbody id="standingsBody">
				{% for runner in lastSoul2026.runners %}
					<tr class="{% if loop.first %}is-winner{% endif %}{% if loop.index > 20 %} is-hidden{% endif %}">
						<td class="st-place">{{ loop.index }}</td>
						<td class="st-name">
							{% if runner.name == "Ello" %}Ayyoub "Ello" El Osrouti{% else %}{{ runner.name }}
							{% endif %}
						</td>
						<td class="st-loops">{{ runner.loops }}</td>
						<td class="st-num">{{ (runner.loops * 6.7) | fixed(1) }} km</td>
						<td class="st-num">{{ runner.totalTime }}</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
	<div class="standings-more">
		<button class="show-more-btn" id="standingsToggle" type="button">
			Show all {{ lastSoul2026.runners | length }} runners
		</button>
	</div>
</div>

<script>
	(function () {
		const button = document.getElementById("standingsToggle");
		const body = document.getElementById("standingsBody");
		if (!button || !body) {
			return;
		}
		let expanded = false;
		const total = body
			.querySelectorAll("tr")
			.length;
		button.addEventListener("click", function () {
			expanded = !expanded;
			body
				.querySelectorAll("tr")
				.forEach(function (row, index) {
					row
						.classList
						.toggle("is-hidden", !expanded && index >= 20);
				});
			button.textContent = expanded
				? "Show top 20 only"
				: "Show all " + total + " runners";
		});
	})();
</script>

